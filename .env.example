# 環境變數清單, 也是 `make init` 產生 .env 的範本。
# 註解只能寫在上一行: `KEY=  # 說明` 的 `# 說明` 會被當成值。
# 正式環境改了任何值: 照 docs/foundation/operations.md 的「套用 .env 的變更」重新部署,
# 接了自動部署的主機不要直接 make start。

# ── 專案 ──────────────────────────────────────────────────────────────────────
# development 或 production, 由 make init dev|prod 寫入
MODE=
# 容器與 volume 的前綴, 只能用小寫英數與 - _
COMPOSE_PROJECT_NAME=my-app
# 顯示在畫面上的系統名稱
SYSTEM_NAME=My App
# 對外唯一的 port (nginx, 只綁 127.0.0.1)
SYSTEM_PORT=3000
# 排程使用的時區 (IANA 名稱)。log 與資料庫一律 UTC, 不受這個值影響
TIMEZONE=Asia/Taipei

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# 自動產生。只在第一次建立資料庫時生效, 之後改這裡只會讓 api 連不上
POSTGRES_PASSWORD=

# ── 認證 ──────────────────────────────────────────────────────────────────────
# 自動產生, 至少 32 字元
JWT_SECRET_KEY=
# 登入後幾小時一定要重新登入 (不續期), 前後端共用
EXPIRE_HOURS=8

# ── 前端 ──────────────────────────────────────────────────────────────────────
# 自動產生。Server Action 的加密金鑰, 改了要重建容器
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── 執行參數 (都有預設值, 需要時才調整) ──────────────────────────────────────
# api 的行程數。1 個就夠, 吃 CPU 的工作交給背景任務; 記憶體上限自動跟著調整
API_PROCESSES=1
# worker 的份數。每一份都做一樣的事, 任務可以並行處理
# API_PROCESSES 與 WORKER_REPLICAS 加起來最多 6 (資料庫連線數的限制)
WORKER_REPLICAS=1
# 容器 log 的去處: json-file 或 journald (Linux 主機, 重建容器後仍保留)
LOG_DRIVER=json-file
# 錯誤追蹤 (Sentry 或相容的 GlitchTip), 留空就不啟用
SENTRY_DSN=
